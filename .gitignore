# build output
/bin/
/dist/
/go/bin/

# node
node_modules/
*.tsbuildinfo

# wrangler
.wrangler/
.dev.vars
.dev.vars.*

# credentials — never commit these
.env
.env.*
!.env.example

# local state and key material — never commit these
*.db
*.db-wal
*.db-shm
*.pem
host_identity
host_identity.pub
ssh_ca
ssh_ca.pub
id_ed25519*
*-cert.pub

# scratch
/tmp/
.DS_Store

# binaries staged into the e2e docker build context
/tests/e2e/grantd
/tests/e2e/grant-signer
/tests/e2e/grantctl
/tests/e2e/grant-agent
/tests/e2e/build/
/tests/install/stage/

# release signing private key must never be committed
grantd-release
grantd-release.pub
